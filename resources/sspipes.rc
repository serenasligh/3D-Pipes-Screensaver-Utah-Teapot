    IDS_GENNAME             "ScreenSaver"
    IDS_INIFILE             "control.ini"
    IDS_TEXTURE             "Texture"
    IDS_TEXTURE_FILE_OFFSET "TextureFileOffset"
    IDS_SIZE                "Size"
    IDS_TESSELATION         "Tesselation"
END

