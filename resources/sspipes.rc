// Combined resource file for sspipes.scr
// All IDs hardcoded to avoid complex header chain issues with windres.

#include <windows.h>
#include "scrnsave.h"

// IDs from scrnsave.h:
//   IDS_DESCRIPTION = 1
//   DLG_SCRNSAVECONFIGURE = 2003
//   ID_APP = 100

// IDs from sscommon.h:
#define IDS_COPYRIGHT           9001
#define IDS_GENNAME             9003
#define IDS_INIFILE             9006
