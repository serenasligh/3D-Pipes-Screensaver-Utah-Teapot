// -----------------------------------------------------------------------
// Application icon
// -----------------------------------------------------------------------

ID_APP ICON "ssopengl.ico"

// -----------------------------------------------------------------------
// Common string resources
// -----------------------------------------------------------------------

STRINGTABLE PRELOAD
BEGIN
    IDS_WARNING             "Warning"
    IDS_ERROR               "Error"
    IDS_START_FAILED        "Screen saver failed to start."
    IDS_BITMAP_SIZE         "The texture must not be larger than %ld by %ld pixels."
    IDS_BITMAP_INVALID      "The texture you selected is not valid."
    IDS_SELECT_ANOTHER_BITMAP  "Please select another texture. %s is not valid."
    IDS_TEXTUREFILTER       "Texture files (*.bmp)"
    IDS_TEXTUREDIALOGTITLE  "Choose Texture File"
    IDS_BMP                 "BMP"
    IDS_DOTBMP              ".BMP"
    IDS_STARDOTBMP          "*.BMP"
    IDS_RGB                 "RGB"
    IDS_DOTRGB              ".RGB"
    IDS_STARDOTRGB          "*.RGB"
