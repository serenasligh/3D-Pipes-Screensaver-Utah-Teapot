// -----------------------------------------------------------------------
// Default texture bitmap embedded as a resource
// -----------------------------------------------------------------------

IDB_DEFTEX   100   DISCARDABLE   "STRIPE.BMP"

// -----------------------------------------------------------------------
// Setup dialog
// -----------------------------------------------------------------------

DLG_SCRNSAVECONFIGURE DIALOG DISCARDABLE  28, 25, 332, 185
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "3D Pipes Setup"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,275,5,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,275,25,50,14,WS_GROUP
    GROUPBOX        "Pipes",-1,5,0,110,50
    CONTROL         "&Single",IDC_RADIO_SINGLE_PIPE,"Button",
                    BS_AUTORADIOBUTTON,15,15,35,10
    CONTROL         "&Multiple",IDC_RADIO_MULTIPLE_PIPES,"Button",
                    BS_AUTORADIOBUTTON,15,30,40,10
    GROUPBOX        "Pipe Style",-1,120,0,150,50
    CONTROL         "&Traditional",IDC_RADIO_NORMAL,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,130,15,55,10
    LTEXT           "&Joint Type:",IDC_STATIC_JOINTTYPE,190,6,35,8
    COMBOBOX        DLG_COMBO_JOINTTYPE,190,15,65,50,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "&Flex",IDC_RADIO_FLEX,"Button",BS_AUTORADIOBUTTON |
                    WS_GROUP | WS_TABSTOP,130,30,35,10
    GROUPBOX        "&Resolution",IDC_STATIC_TESS_GRP,5,55,110,50
    LTEXT           "Min",IDC_STATIC_TESS_MIN,15,70,30,7
    RTEXT           "Max",IDC_STATIC_TESS_MAX,85,70,20,7
    CONTROL         "Slider1",DLG_SETUP_TESSEL,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,15,80,90,15
    GROUPBOX        "Surface Style",-1,120,55,150,50,WS_GROUP
    CONTROL         "Soli&d",IDC_RADIO_SOLID,"Button",BS_AUTORADIOBUTTON |
                    WS_GROUP | WS_TABSTOP,130,70,35,13
    CONTROL         "Te&xtured",IDC_RADIO_TEX,"Button",BS_AUTORADIOBUTTON |
                    WS_GROUP | WS_TABSTOP,130,85,48,14
    PUSHBUTTON      "&Choose Texture...",DLG_SETUP_TEXTURE,184,85,66,14
    GROUPBOX        "Teapot Frequency",IDC_STATIC_TEAPOT_GRP,5,112,155,50
    LTEXT           "Common",IDC_STATIC_TEAPOT_MIN,15,125,35,7
    RTEXT           "Rare",IDC_STATIC_TEAPOT_MAX,130,125,20,7
    CONTROL         "Slider2",IDC_SLIDER_TEAPOT_ODDS,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,15,135,130,15
    GROUPBOX        "Speed",IDC_STATIC_SPEED_GRP,165,112,155,50
    LTEXT           "Slow",IDC_STATIC_SPEED_MIN,175,125,20,7
    RTEXT           "Fast",IDC_STATIC_SPEED_MAX,290,125,20,7
    CONTROL         "Slider3",IDC_SLIDER_SPEED,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,175,135,130,15
    CONTROL         "&Enable Utah Teapot easter egg",IDC_CHECK_TEAPOT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,168,170,12
END
