// -----------------------------------------------------------------------
// Default texture bitmap embedded as a resource
// -----------------------------------------------------------------------

IDB_DEFTEX   100   DISCARDABLE   "STRIPE.BMP"

// -----------------------------------------------------------------------
// Setup dialog
//
// Layout (all y-coordinates absolute):
//   Row 1  y=  0 h=70 : Pipes + Pipe Style
//                        (Default / Flex / Alternate + Switch Odds /
//                         Incl. Teapot + Joint Type)
//   Row 2  y= 75 h=65 : Resolution + Surface Style (Solid / Textured / :3)
//   Row 3  y=145 h=52 : Teapot Frequency + Speed
//   Row 4  y=202 h=58 : Dissolve (Duration slider + Smooth/Pixelated + Res slider)
//   Dialog total height = 265
// -----------------------------------------------------------------------

DLG_SCRNSAVECONFIGURE DIALOG DISCARDABLE  28, 25, 280, 285
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "3D Pipes Setup"
FONT 8, "MS Shell Dlg"
BEGIN
    // -----------------------------------------------------------------
    // Row 1 (y=5, h=70): Pipes and Pipe Style — both groups same height
    // -----------------------------------------------------------------
    GROUPBOX        "Pipes",-1,5,5,110,70
    CONTROL         "&Single",IDC_RADIO_SINGLE_PIPE,"Button",
                    BS_AUTORADIOBUTTON,15,18,35,10
    CONTROL         "&Multiple",IDC_RADIO_MULTIPLE_PIPES,"Button",
                    BS_AUTORADIOBUTTON,15,33,40,10

    GROUPBOX        "Pipe Style",-1,120,5,155,70
    CONTROL         "&Default",IDC_RADIO_NORMAL,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,130,18,40,10
    CONTROL         "&Flex",IDC_RADIO_FLEX,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,130,33,35,10
    CONTROL         "&Alternate",IDC_CHECK_ALTERNATE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,130,51,50,10

    CONTROL         "Add &Utah Teapot",IDC_CHECK_TEAPOT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,187,13,80,10
    LTEXT           "&Joint Type:",IDC_STATIC_JOINTTYPE,187,26,37,8
    COMBOBOX        DLG_COMBO_JOINTTYPE,187,35,60,50,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT           "Switch Odds:",-1,187,48,50,8
    COMBOBOX        IDC_COMBO_SWITCHODDS,187,57,57,50,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_GROUP | WS_TABSTOP

    // -----------------------------------------------------------------
    // Row 2 (y=78, h=65): Resolution and Surface Style — both groups same height
    // -----------------------------------------------------------------
    GROUPBOX        "&Resolution",IDC_STATIC_TESS_GRP,5,78,110,65
    LTEXT           "Min",IDC_STATIC_TESS_MIN,15,91,30,7
    RTEXT           "Max",IDC_STATIC_TESS_MAX,85,91,20,7
    CONTROL         "Slider1",DLG_SETUP_TESSEL,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,15,101,90,15

    GROUPBOX        "Surface Style",-1,120,78,155,65,WS_GROUP
    CONTROL         "Soli&d",IDC_RADIO_SOLID,"Button",BS_AUTORADIOBUTTON |
                    WS_GROUP | WS_TABSTOP,130,91,35,13
    CONTROL         "Te&xtured",IDC_RADIO_TEX,"Button",BS_AUTORADIOBUTTON |
                    WS_GROUP | WS_TABSTOP,130,106,48,14
    CONTROL         ":&3",IDC_CHECK_TRANS,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP,185,91,25,10
    PUSHBUTTON      "&Choose Texture...",DLG_SETUP_TEXTURE,184,106,66,14

    // -----------------------------------------------------------------
    // Row 3 (y=146, h=52): Teapot Frequency and Speed — both groups same height
    // -----------------------------------------------------------------
    GROUPBOX        "Teapot Frequency",IDC_STATIC_TEAPOT_GRP,5,146,130,52
    LTEXT           "Common",IDC_STATIC_TEAPOT_MIN,14,159,35,7
    RTEXT           "Rare",IDC_STATIC_TEAPOT_MAX,109,159,20,7
    CONTROL         "Slider2",IDC_SLIDER_TEAPOT_ODDS,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,14,169,112,15

    GROUPBOX        "Speed",IDC_STATIC_SPEED_GRP,140,146,135,52
    LTEXT           "Slow",IDC_STATIC_SPEED_MIN,150,159,20,7
    RTEXT           "Fast",IDC_STATIC_SPEED_MAX,255,159,16,7
    CONTROL         "Slider3",IDC_SLIDER_SPEED,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,150,169,117,15

    // -----------------------------------------------------------------
    // Row 4 (y=201, h=62): Dissolve
    //   Left  (x=14..126): Duration slider — Instant → 8 sec
    //   Middle (x=132):    Smooth / Pixelated radios
    //   Right  (x=196..269): Fine ←→ Coarse resolution slider
    //   Both sliders share the same y so they appear visually aligned.
    // -----------------------------------------------------------------
    GROUPBOX        "Dissolve",IDC_STATIC_DISSOLVE_GRP,5,201,270,62
    LTEXT           "Instant",IDC_STATIC_DISSOLVE_MIN,14,213,30,7
    RTEXT           "8 sec",IDC_STATIC_DISSOLVE_MAX,91,213,33,7
    CONTROL         "Slider4",IDC_SLIDER_DISSOLVE_TIME,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,14,222,112,15

    CONTROL         "&Smooth",IDC_RADIO_DISSOLVE_SMOOTH,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,132,213,50,10
    CONTROL         "&Pixelated",IDC_RADIO_DISSOLVE_PIXELATED,"Button",
                    BS_AUTORADIOBUTTON,132,226,60,10
    LTEXT           "Fine",IDC_STATIC_DISSOLVE_RES_MIN,196,213,20,7
    RTEXT           "Coarse",IDC_STATIC_DISSOLVE_RES_MAX,243,213,28,7
    CONTROL         "Slider5",IDC_SLIDER_DISSOLVE_RES,"msctls_trackbar32",
                    TBS_NOTICKS | WS_GROUP | WS_TABSTOP,196,222,73,15

    // -----------------------------------------------------------------
    // OK / Cancel centred at the bottom of the dialog
    // -----------------------------------------------------------------
    DEFPUSHBUTTON   "OK",IDOK,88,268,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,143,268,50,14,WS_GROUP
END
